<%-
  base_url = "/node/#{host}/#{port}/"
-%>
<div class="row">
  <div class="col-md-4">
    <a class="btn btn-primary" target="_blank" href="<%= base_url %>">
      <i class="fa fa-terminal"></i> Connect to GitHub Copilot
    </a>
  </div>
</div>

<p class="mt-3">
  When prompted by the browser, sign in with your cluster username and the session password
  shown above. Complete <code>copilot login</code> in the terminal
  the first time you use this session.
</p>
